# 서버 바인딩 주소/포트 (python -m app.main, Docker 실행 시 사용)
HOST=0.0.0.0
PORT=8000

# 업로드 응답의 url 필드에 사용할 외부 공개 주소 (http:// 또는 https:// 포함, 끝의 / 제외)
PUBLIC_BASE_URL=http://localhost:8000

# 보고서 저장 디렉터리
REPORTS_DIR=./data/reports

# 최대 업로드 크기 (MB)
MAX_UPLOAD_SIZE_MB=10

# 관리자 키. 설정 페이지(/settings) 로그인에 쓰이고, 업로드 API(X-API-Key)에도 항상 쓸 수 있습니다.
# 비워두면 설정 페이지가 비활성화되고, 설정 페이지에서 만든 토큰도 없으면 업로드 API도 비활성화됩니다. 반드시 변경하세요.
#   생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_API_KEY=change-me

# 설정 페이지 데이터(tokens.csv, settings.json) 저장 디렉터리
CONFIG_DIR=./data/config

# 목록 페이지와 업로드 응답의 시간대
TZ=Asia/Seoul

# (선택) PUBLIC_BASE_URL이 없을 때 응답 URL에 쓸 수 있는 Host 이름 (쉼표 구분, 기본값 아래와 같음)
# ALLOWED_HOSTS=localhost,127.0.0.1,::1

# (선택) 로그 레벨: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
